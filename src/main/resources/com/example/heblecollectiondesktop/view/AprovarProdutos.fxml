<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="20.0" style="-fx-padding: 24; -fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.heblecollectiondesktop.controller.ControllerAprovarProdutos">
    <children>
        <Button mnemonicParsing="false" onAction="#voltarAoHub" style="-fx-background-color: transparent; -fx-text-fill: #64748B; -fx-cursor: hand;" text="← Voltar ao Painel" />

        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <VBox HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Aprovação de Produtos" textFill="#0F172A">
                            <font>
                                <Font name="System Bold" size="22.0" />
                            </font>
                        </Label>
                        <Label text="Análise gerencial de submissões das empresas parceiras" textFill="#64748B" />
                    </children>
                </VBox>

                <Button fx:id="btnAprovar" mnemonicParsing="false" onAction="#acaoAprovarProduto" prefHeight="40.0" style="-fx-background-color: #d6b667; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;" text="✓ Aprovar Pedido">
                    <font>
                        <Font name="System Bold" size="13.0" />
                    </font>
                </Button>

                <Button fx:id="btnRejeitar" mnemonicParsing="false" onAction="#acaoRejeitarProduto" prefHeight="40.0" style="-fx-background-color: #EF4444; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;" text="✕ Rejeitar Pedido">
                    <font>
                        <Font name="System Bold" size="13.0" />
                    </font>
                </Button>
            </children>
        </HBox>

        <TableView fx:id="tvProdutosPendentes" style="-fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8;" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                <TableColumn fx:id="colEmpresa" prefWidth="180.0" text="Empresa Solicitante" />
                <TableColumn fx:id="colNome" prefWidth="200.0" text="Nome do Produto" />
                <TableColumn fx:id="colCategoria" prefWidth="210.0" text="Descrição" />
                <TableColumn fx:id="colPreco" prefWidth="100.0" text="Preço (R$)" />
                <TableColumn fx:id="colEstoque" prefWidth="80.0" text="Estoque" />
                <TableColumn fx:id="colStatus" prefWidth="110.0" text="Status" />
            </columns>
        </TableView>
    </children>
</VBox>
