<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefWidth="420.0" spacing="15.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.heblecollectiondesktop.controller.ControllerBanirConsumidor">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label text="Banir Consumidor" textFill="#d6b667">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <Label fx:id="lblFuncionarioInfo" text="Banindo: " textFill="#555555" wrapText="true">
         <font>
            <Font size="13.0" />
         </font>
      </Label>
      <VBox spacing="5.0">
         <children>
            <Label text="Motivo do Ban: *" />
            <ComboBox fx:id="cbMotivo" maxWidth="1.1796493086E308" promptText="Selecione o motivo..." />
         </children>
      </VBox>
      <VBox spacing="5.0">
         <children>
            <Label text="Observações / Detalhes (Log):" />
            <TextArea fx:id="txtObservacao" prefHeight="100.0" promptText="Informe observações adicionais para a moderação..." wrapText="true" />
         </children>
      </VBox>
      <HBox alignment="CENTER_RIGHT" spacing="10.0">
         <children>
            <Button fx:id="btnCancelar" mnemonicParsing="false" onAction="#cancelar" text="Cancelar" />
            <Button mnemonicParsing="false" onAction="#confirmarBanimento" style="-fx-background-color: #ff0000; -fx-text-fill: white;" text="Confirmar Banimento" />
         </children>
         <VBox.margin>
            <Insets top="10.0" />
         </VBox.margin>
      </HBox>
   </children>
</VBox>
