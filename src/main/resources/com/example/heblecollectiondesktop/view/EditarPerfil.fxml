<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="436.0" prefWidth="362.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.heblecollectiondesktop.controller.ControllerEditarPerfil">
   <children>
      <Button fx:id="btnEditar" layoutX="253.0" layoutY="384.0" mnemonicParsing="false" onAction="#EditarPerfil" prefHeight="38.0" prefWidth="84.0" style="-fx-background-color: d6b667; -fx-background-radius: 8" text="Editar " textFill="WHITE">
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Button>
      <Button fx:id="BtnLimpar" layoutX="16.0" layoutY="384.0" mnemonicParsing="false" onAction="#Limpar" prefHeight="38.0" prefWidth="65.0" style="-fx-background-radius: 8;" text="Limpar">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Button>
      <Label layoutX="29.0" layoutY="28.0" text="Edição de Perfil">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <Label layoutX="49.0" layoutY="107.0" prefHeight="27.0" prefWidth="65.0" text="Matrícula:">
         <font>
            <Font size="14.0" />
