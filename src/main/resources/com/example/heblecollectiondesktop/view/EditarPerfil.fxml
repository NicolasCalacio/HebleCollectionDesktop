      </Label>
      <TextField fx:id="txNome" layoutX="42.0" layoutY="134.0" prefHeight="25.0" prefWidth="289.0" promptText="Digite o nome" />
      <Label layoutX="49.0" layoutY="166.0" prefHeight="27.0" prefWidth="65.0" text="Senha:">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <TextField fx:id="txSenha" layoutX="42.0" layoutY="193.0" prefHeight="25.0" prefWidth="289.0" promptText="Digite a Nova Senha" />
      <Button fx:id="btnCancelar" layoutX="179.0" layoutY="384.0" mnemonicParsing="false" onAction="#Cancelar" prefHeight="38.0" prefWidth="65.0" style="-fx-background-radius: 8;" text="Cancelar">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
