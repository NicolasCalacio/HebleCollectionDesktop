<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="760.0" prefWidth="1200.0" spacing="20.0" style="-fx-padding: 24; -fx-background-color: White;" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.heblecollectiondesktop.controller.ControllerExibirPerfil">
   <children>
      <Button mnemonicParsing="false" onAction="#Voltar" style="-fx-background-color: transparent; -fx-text-fill: #64748B; -fx-cursor: hand;" text="← Voltar" />
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <HBox prefHeight="60.0" prefWidth="1190.0">
               <children>
                  <ImageView fitHeight="60.0" fitWidth="78.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../images/images.png" />
                     </image>
                  </ImageView>
               </children>
               <HBox.margin>
                  <Insets left="550.0" />
               </HBox.margin>
            </HBox>
         </children>
      </HBox>
      <Label fx:id="lblPerfil" prefHeight="48.0" prefWidth="572.0" textAlignment="JUSTIFY">
         <font>
            <Font name="Arial Bold" size="26.0" />
         </font>
         <VBox.margin>
            <Insets left="300.0" />
         </VBox.margin>
      </Label>
      <Label fx:id="lblId" prefHeight="35.0" prefWidth="601.0" textAlignment="JUSTIFY">
         <font>
            <Font name="Arial Bold" size="16.0" />
         </font>
         <VBox.margin>
            <Insets left="300.0" />
         </VBox.margin></Label>
      <Label fx:id="lblCargo" prefHeight="38.0" prefWidth="574.0" textAlignment="JUSTIFY">
         <font>
            <Font name="Arial Bold" size="16.0" />
         </font>
         <VBox.margin>
            <Insets left="300.0" />
         </VBox.margin>
      </Label>
      <Label text="Visualize e Edite seu usuário" textFill="#64748B">
         <VBox.margin>
            <Insets left="500.0" />
         </VBox.margin></Label>
      <Button fx:id="btnEditarPerfil" mnemonicParsing="false" onAction="#EditarPerfil" prefHeight="40.0" style="-fx-background-color: #d6b667; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;" text="✏ Editar Perfil">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
         <VBox.margin>
            <Insets left="520.0" />
         </VBox.margin>
      </Button>
   </children>
</VBox>
