<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="760.0" prefWidth="1200.0" style="-fx-background-color: #EDF2F7;" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.heblecollectiondesktop.controller.ControllerExibirPerfil">
   <children>
      <VBox alignment="TOP_LEFT" prefHeight="760.0" prefWidth="1200.0" spacing="20.0" style="-fx-padding: 30;">
         <children>
            <Button mnemonicParsing="false" onAction="#Voltar" style="-fx-background-color: transparent; -fx-text-fill: #64748B; -fx-font-weight: bold; -fx-cursor: hand;" text="← Voltar ao Painel" />

            <VBox alignment="CENTER" maxWidth="-Infinity" prefWidth="1140.0" VBox.vgrow="ALWAYS">
               <children>
                  <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefWidth="480.0" spacing="20.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 20; -fx-padding: 35;">
                     <effect>
                        <DropShadow blurType="THREE_PASS_BOX" height="30.0" radius="14.5" width="30.0">
                           <color>
                              <Color opacity="0.12" />
                           </color>
                        </DropShadow>
                     </effect>
                     <children>
                        <ImageView fitHeight="80.0" fitWidth="80.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../images/images.png" />
                           </image>
                        </ImageView>

                        <VBox alignment="CENTER" spacing="4.0">
                           <children>
                              <Label text="Perfil do Usuário" textFill="#0F172A">
                                 <font>
                                    <Font name="System Bold" size="22.0" />
                                 </font>
                              </Label>
                              <Label text="Informações de cadastro do operador" textFill="#64748B">
                                 <font>
                                    <Font size="13.0" />
                                 </font>
                              </Label>
                           </children>
                        </VBox>

                        <!-- Bloco Visual das Informações -->
                        <VBox alignment="CENTER_LEFT" prefWidth="410.0" spacing="10.0" style="-fx-background-color: #F8FAFC; -fx-background-radius: 12; -fx-padding: 16; -fx-border-color: #E2E8F0; -fx-border-radius: 12;">
                           <children>
                              <HBox spacing="8.0">
                                 <children>
                                    <Label text="Matrícula:" textFill="#64748B">
                                       <font>
                                          <Font name="System Bold" size="14.0" />
                                       </font>
                                    </Label>
                                    <Label fx:id="lblPerfil" text="Carregando..." textFill="#1E293B">
                                       <font>
                                          <Font name="System Bold" size="14.0" />
                                       </font>
                                    </Label>
                                 </children>
                              </HBox>
                              <HBox spacing="8.0">
                                 <children>
                                    <Label text="ID no Sistema:" textFill="#64748B">
                                       <font>
                                          <Font name="System Bold" size="14.0" />
                                       </font>
                                    </Label>
                                    <Label fx:id="lblId" text="Carregando..." textFill="#1E293B">
                                       <font>
                                          <Font size="14.0" />
                                       </font>
                                    </Label>
                                 </children>
                              </HBox>
                              <HBox spacing="8.0">
                                 <children>
                                    <Label text="Cargo:" textFill="#64748B">
                                       <font>
                                          <Font name="System Bold" size="14.0" />
                                       </font>
                                    </Label>
                                    <Label fx:id="lblCargo" text="Carregando..." textFill="#1E293B">
                                       <font>
                                          <Font size="14.0" />
                                       </font>
                                    </Label>
                                 </children>
                              </HBox>
                           </children>
                        </VBox>

                        <Button fx:id="btnEditarPerfil" mnemonicParsing="false" onAction="#irparaEditarPerfil" prefHeight="42.0" prefWidth="410.0" style="-fx-background-color: #d6b667; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;" text="✏ Editar Minhas Informações">
                           <font>
                              <Font name="System Bold" size="13.0" />
                           </font>
                        </Button>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</StackPane>