<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox spacing="20.0" style="-fx-padding: 24; -fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.heblecollectiondesktop.controller.ControllerGerenciarEmpresas">
   <children>
      <Button mnemonicParsing="false" onAction="#voltarAoHub" style="-fx-background-color: transparent; -fx-text-fill: #64748B; -fx-cursor: hand;" text="← Voltar" />
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <VBox HBox.hgrow="ALWAYS">
               <children>
                  <Label text="Gestão de Empresas" textFill="#0F172A">
                     <font>
                        <Font name="System Bold" size="22.0" />
                     </font>
                  </Label>
                  <Label text="Visualize, aprove e gerencie os acessos do sistema" textFill="#64748B" />
               </children>
            </VBox>

            <Button fx:id="btnAprovarEmpresas" mnemonicParsing="false" onAction="#irParaAprovarEmpresa" prefHeight="40.0" style="-fx-background-color: #d6b667; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;" text="+ Aprovar Empresas">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Button>

            <Button fx:id="btnEditarEmpresas" mnemonicParsing="false" onAction="#AbrirEditarEmpresa" prefHeight="40.0" style="-fx-background-color: #d6b667; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;" text="* Editar Empresa">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Button>
            <Button fx:id="btnDeletarEmpresa" mnemonicParsing="false" onAction="#deletarEmpresa" prefHeight="40.0" style="-fx-background-color: #d6b667; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;" text="🗑 Deletar Empresa">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Button>
         </children>
      </HBox>
      <TableView fx:id="TabelaEmpresas" prefHeight="400.0" style="-fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8;" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="colID" prefWidth="60.0" text="ID" />
            <TableColumn fx:id="colNome" prefWidth="203.0" text="Nome" />
            <TableColumn fx:id="colCNPJ" prefWidth="211.0" text="CNPJ" />
            <TableColumn fx:id="colEstilo" prefWidth="210.0" text="Estilo" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </children>
</VBox>
