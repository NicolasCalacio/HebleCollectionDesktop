<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefWidth="480.0" spacing="12.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.heblecollectiondesktop.controller.ControllerTelaInfoCupom">
    <padding>
        <Insets bottom="16.0" left="20.0" right="20.0" top="16.0" />
    </padding>
    <children>

        <Label fx:id="lblCodigoCupom" text="Codigo do Cupom:" textFill="#1e1e1e">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Label>
        <Separator />


        <Label fx:id="lblId" text="ID: ">
            <font>
                <Font name="System Bold" size="13.0" />
            </font>
        </Label>
      <Label fx:id="lblStatus" text="Status:">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Label>


        <Label fx:id="lblValorDesconto" text="Valor do desconto(%):">
            <font>
                <Font name="System Bold" size="13.0" />
            </font>
            <VBox.margin>
                <Insets top="4.0" />
            </VBox.margin>
        </Label>
      <Label fx:id="lblValorMinimo" text="Valor Minimo:">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Label>
      <Label fx:id="lblValidade" text="Validade:">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Label>


        <HBox alignment="BOTTOM_RIGHT">
            <VBox.margin>
                <Insets top="8.0" />
            </VBox.margin>
        </HBox>
    </children>
</VBox>
