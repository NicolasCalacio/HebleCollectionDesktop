<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefWidth="480.0" spacing="12.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.heblecollectiondesktop.controller.ControllerTelaInfoProdutos">
   <padding>
      <Insets bottom="16.0" left="20.0" right="20.0" top="16.0" />
   </padding>
   <children>
      <Label fx:id="lblCodigoCupom" text="Informações do Produto :" textFill="#1e1e1e">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Label>
      <Separator />
      <AnchorPane prefHeight="200.0" prefWidth="200.0">
         <children>
            <Label fx:id="lblId" layoutX="14.0" layoutY="14.0" text="ID: ">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Label>
            <Label fx:id="lblEmpresaProduto" layoutX="14.0" layoutY="39.0" text="Empresa do Produto:">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Label>
            <Label fx:id="lblNome" layoutX="15.0" layoutY="65.0" text="Nome:">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Label>
            <Label fx:id="lblDescricao" layoutX="15.0" layoutY="100.0" text="Descrição:">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Label>
            <Label fx:id="lblPreco" layoutX="298.0" layoutY="14.0" text="Preço:">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Label>
            <Label fx:id="lblEstoque" layoutX="298.0" layoutY="39.0" text="Estoque:">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Label>
            <Label fx:id="lblStatus" layoutX="297.0" layoutY="67.0" text="Status:">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Label>
            <TextArea fx:id="txtDescricao" layoutX="14.0" layoutY="119.0" prefHeight="94.0" prefWidth="420.0" />
         </children>
      </AnchorPane>
   </children>
</VBox>
