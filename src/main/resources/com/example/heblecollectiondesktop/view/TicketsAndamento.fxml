<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="500.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.heblecollectiondesktop.controller.ControllerTicketsAndamento">
   <children>
      <VBox spacing="20.0" style="-fx-padding: 24; -fx-background-color: #F8FAFC;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Button mnemonicParsing="false" onAction="#voltarAoHub" style="-fx-background-color: transparent; -fx-text-fill: #64748B; -fx-cursor: hand;" text="← Voltar ao Hub" />

            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <VBox HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Tickets em Andamento" textFill="#0F172A">
                           <font>
                              <Font name="System Bold" size="22.0" />
                           </font>
                        </Label>
                        <Label text="Acompanhe e gerencie os seus chamados nessa tela" textFill="#64748B" />
                     </children>
                  </VBox>
                  <Button fx:id="btnAprovarTicket" mnemonicParsing="false" onAction="#aprovarTicket" prefHeight="40.0" style="-fx-background-color: #22c55e; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;" text="✓ Aprovar">
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                  </Button>
                  <Button fx:id="btnNegarTicket" mnemonicParsing="false" onAction="#negarTicket" prefHeight="40.0" style="-fx-background-color: #f59e0b; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;" text="✕ Negar">
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                  </Button>
               </children>
            </HBox>

            <TableView fx:id="ticketsEmAndamento" prefHeight="400.0" style="-fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8;" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colID" prefWidth="60.0" text="ID" />
                  <TableColumn fx:id="colAssunto" prefWidth="180.0" text="Assunto" />
                  <TableColumn fx:id="colDescricao" prefWidth="250.0" text="Descrição" />
                  <TableColumn fx:id="colStatus" prefWidth="100.0" text="Status" />
                  <TableColumn fx:id="colFuncionarioId" prefWidth="110.0" text="Funcionário ID" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </children>
</AnchorPane>
