<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="20.0" style="-fx-padding: 24; -fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.heblecollectiondesktop.controller.ControllerVendas">
    <children>
        <Button mnemonicParsing="false" onAction="#voltarAoHub" style="-fx-background-color: transparent; -fx-text-fill: #64748B; -fx-cursor: hand;" text="← Voltar ao Painel" />

        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <VBox HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Gerenciamento de Vendas" textFill="#0F172A">
                            <font>
                                <Font name="System Bold" size="22.0" />
                            </font>
                        </Label>
                        <Label text="Acompanhamento gerencial e histórico das transações realizadas" textFill="#64748B" />
                    </children>
                </VBox>

                <Button fx:id="btnRelatorioMes" mnemonicParsing="false" onAction="#acaoRelatorioMes" prefHeight="40.0" style="-fx-background-color: #d6b667; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;" text="📊 Relatório do Mês">
                    <font>
                        <Font name="System Bold" size="13.0" />
                    </font>
                </Button>

                <Button fx:id="btnDetalhesVenda" mnemonicParsing="false" onAction="#acaoDetalhesVenda" prefHeight="40.0" style="-fx-background-color: #3B82F6; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;" text="👁 Ver Detalhes">
                    <font>
                        <Font name="System Bold" size="13.0" />
                    </font>
                </Button>
            </children>
        </HBox>

        <TableView fx:id="tvVendas" style="-fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8;" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colIdVenda" prefWidth="60.0" text="ID" />
                <TableColumn fx:id="colCliente" prefWidth="220.0" text="Cliente / Comprador" />
                <TableColumn fx:id="colData" prefWidth="130.0" text="Data da Venda" />
                <TableColumn fx:id="colItens" prefWidth="220.0" text="Itens / Resumo" />
                <TableColumn fx:id="colTotal" prefWidth="120.0" text="Total (R$)" />
                <TableColumn fx:id="colStatusVenda" prefWidth="110.0" text="Status" />
            </columns>
        </TableView>
    </children>
</VBox>