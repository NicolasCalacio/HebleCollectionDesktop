<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.text.*?>

<StackPane prefHeight="760.0" prefWidth="1200.0" style="-fx-background-color: #EDF2F7;" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.heblecollectiondesktop.controller.ControllerLogin">
   <children>
      <VBox alignment="CENTER" fillWidth="false" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="480.0" minWidth="400.0" prefHeight="510.0" prefWidth="420.0" spacing="14.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 20; -fx-padding: 35;">
         <effect>
            <DropShadow blurType="THREE_PASS_BOX" height="30.0" radius="14.5" width="30.0">
               <color>
                  <Color opacity="0.12" />
               </color>
            </DropShadow>
         </effect>
         <children>
            <ImageView fx:id="imgLogo" fitHeight="60.0" fitWidth="60.0" preserveRatio="true">
               <image>
                  <Image url="@../images/IMG_0516.JPG" />
               </image></ImageView>

            <VBox alignment="CENTER" prefWidth="350.0" spacing="2.0">
               <children>
                  <Label text="Heble Collection" textFill="#0F172A">
                     <font>
                        <Font name="System Bold" size="22.0" />
                     </font>
                  </Label>
                  <Label text="Entre com suas credenciais de acesso" textFill="#64748B">
                     <font>
                        <Font size="13.0" />
                     </font>
                  </Label>
               </children>
            </VBox>

            <VBox alignment="CENTER_LEFT" prefWidth="350.0" spacing="4.0">
               <children>
                  <Label text="Matrícula" textFill="#334155">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>
                  <TextField fx:id="txMatricula" prefHeight="42.0" prefWidth="350.0" promptText="Digite sua matrícula" style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 0 12;" />
               </children>
            </VBox>

            <VBox alignment="CENTER_LEFT" prefWidth="350.0" spacing="4.0">
               <children>
                  <Label text="Senha" textFill="#334155">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>
                  <PasswordField fx:id="txSenha" prefHeight="42.0" prefWidth="350.0" promptText="••••••••" style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 0 12;" />
               </children>
            </VBox>

            <Button fx:id="btnLogin" mnemonicParsing="false" onAction="#fazerLogin" prefHeight="42.0" prefWidth="350.0" style="-fx-background-color: #111118; -fx-text-fill: #FFFFFF; -fx-background-radius: 8; -fx-font-weight: bold; -fx-font-size: 13px; -fx-cursor: hand;" text="Entrar no sistema">
               <VBox.margin>
                  <Insets top="8.0" />
               </VBox.margin>
            </Button>

            <HBox alignment="CENTER" prefWidth="350.0" spacing="5.0">
               <children>
                  <Label text="Esqueceu a senha?" textFill="#94A3B8">
                     <font>
                        <Font size="12.0" />
                     </font>
                  </Label>
                  <Label fx:id="lblSuporte" onMouseClicked="#abrirsuporte" style="-fx-cursor: hand;" text="Fale com o suporte" textFill="#2563EB">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</StackPane>
