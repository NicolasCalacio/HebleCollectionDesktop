<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.text.*?>

<StackPane prefHeight="760.0" prefWidth="1200.0" style="-fx-background-color: rgba(0, 0, 0, 0.4);" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.heblecollectiondesktop.controller.ControllerModalSair">
    <children>
        <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="240.0" minWidth="380.0" prefHeight="260.0" prefWidth="400.0" spacing="16.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 20; -fx-padding: 30;">
            <effect>
                <DropShadow blurType="THREE_PASS_BOX" height="30.0" radius="14.5" width="30.0">
                    <color>
                        <Color opacity="0.15" />
                    </color>
                </DropShadow>
            </effect>
            <children>
                <VBox alignment="CENTER" spacing="4.0">
                    <children>
                        <Label text="Opções de Saída" textFill="#0F172A">
                            <font>
                                <Font name="System Bold" size="20.0" />
                            </font>
                        </Label>
                        <Label text="O que você deseja fazer agora?" textFill="#64748B">
                            <font>
                                <Font size="13.0" />
                            </font>
                        </Label>
                    </children>
                    <VBox.margin>
                        <Insets bottom="10.0" />
                    </VBox.margin>
                </VBox>

                <VBox spacing="10.0">
                    <children>
                        <Button fx:id="btnDeslogar" mnemonicParsing="false" onAction="#acaoDeslogar" prefHeight="42.0" prefWidth="340.0" style="-fx-background-color: #d6b667; -fx-text-fill: #FFFFFF; -fx-background-radius: 8; -fx-font-weight: bold; -fx-font-size: 13px; -fx-cursor: hand;" text="Voltar ao Login" />

                        <Button fx:id="btnSairSistema" mnemonicParsing="false" onAction="#acaoSairSistema" prefHeight="42.0" prefWidth="340.0" style="-fx-background-color: #EF4444; -fx-text-fill: #FFFFFF; -fx-background-radius: 8; -fx-font-weight: bold; -fx-font-size: 13px; -fx-cursor: hand;" text="Sair do Sistema" />

                        <Button fx:id="btnCancelar" mnemonicParsing="false" onAction="#acaoCancelar" prefHeight="42.0" prefWidth="340.0" style="-fx-background-color: #E2E8F0; -fx-text-fill: #334155; -fx-background-radius: 8; -fx-font-weight: bold; -fx-font-size: 13px; -fx-cursor: hand;" text="Cancelar" />
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</StackPane>
