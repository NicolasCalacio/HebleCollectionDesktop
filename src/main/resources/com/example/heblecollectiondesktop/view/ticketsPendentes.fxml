<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="20.0" style="-fx-padding: 24; -fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.heblecollectiondesktop.controller.ControllerTicketsPendentes">
   <children>
      <Button mnemonicParsing="false" onAction="#voltarAoHub" style="-fx-background-color: transparent; -fx-text-fill: #64748B; -fx-cursor: hand;" text="← Voltar ao Painel" />
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <VBox HBox.hgrow="ALWAYS">
               <children>
                  <Label text="Tickets Pendentes" textFill="#0F172A">
                     <font>
                        <Font name="System Bold" size="22.0" />
                     </font>
                  </Label>
                  <Label text="Visualize, aprove e gerencie os tickets enviados" textFill="#64748B" />
               </children>
            </VBox>
            <Button fx:id="btnAprovarTicket" mnemonicParsing="false" onAction="#AprovarTicket" prefHeight="40.0" style="-fx-background-color: #d6b667; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;" text=" Aprovar Ticket">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Button>
            <Button fx:id="btnRejeitarTicket" mnemonicParsing="false" onAction="#RejeitarTicket" prefHeight="40.0" style="-fx-background-color: #f81d1d; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;" text="Rejeitar Ticket">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Button>
         </children>
      </HBox>
         <TableView fx:id="TabelaTickets" prefHeight="400.0" style="-fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8;" VBox.vgrow="ALWAYS">
            <columns>
               <TableColumn fx:id="colID" prefWidth="60.0" text="ID" />
               <TableColumn fx:id="colTipo" prefWidth="120.0" text="Tipo" /> <!-- Adicionado aqui -->
               <TableColumn fx:id="colAssunto" prefWidth="150.0" text="Assunto" />
               <TableColumn fx:id="ColDescricao" prefWidth="180.0" text="Descrição" />
               <TableColumn fx:id="colStatus" prefWidth="150.0" text="Status" />
            </columns>
            <columnResizePolicy>
               <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </children>
</VBox>
